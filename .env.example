# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (dashboard.clerk.com -> BG_LIB -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Created when you add the webhook endpoint in Clerk (starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Supabase (project boardgame-hub-dev) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the client. Use the legacy `service_role` JWT (starts with eyJ),
# or a FULL sb_secret_ key copied when it was created: the CLI/dashboard show it masked afterwards.
SUPABASE_SERVICE_ROLE_KEY=

# --- BoardGameGeek (optional until the token request is approved) ---
# Request one at https://boardgamegeek.com/applications
BGG_API_TOKEN=

# --- Manual search (optional: without BRAVE_SEARCH_API_KEY the "Search manual" button says it is unavailable) ---
# Brave Search API key: https://api-dashboard.search.brave.com/ (server only; never NEXT_PUBLIC)
BRAVE_SEARCH_API_KEY=
# Signs the short-lived download links of search results (32+ random chars, server only).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MANUAL_LINK_SECRET=
# Optional: the app's own cap of search API calls per month (default 800; keep it under your plan).
MANUAL_MONTHLY_CALL_LIMIT=
