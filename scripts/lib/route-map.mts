import { readdirSync, readFileSync } from "node:fs";
import { join, relative, sep } from "node:path";

/**
 * Builds docs/ROUTES.md: URL → page file → view(s) it renders.
 * Rule (ADR-047): a page is `src/app/[locale]/**\/page.tsx`; a view is a
 * screen body in `src/features/<f>/views/`; everything else is a component.
 */

function walk(dir: string): string[] {
  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) =>
    entry.isDirectory() ? walk(join(dir, entry.name)) : [join(dir, entry.name)],
  );
}

const posix = (p: string) => p.split(sep).join("/");

/** `(app)/games/[id]/page.tsx` (relative to `[locale]`) → `/games/:id`. */
export function routeUrl(pageRelPath: string): string {
  const segments = posix(pageRelPath)
    .split("/")
    .slice(0, -1) // drop "page.tsx"
    .filter((s) => !/^\(.*\)$/.test(s))
    .map((s) =>
      /^\[\[?\.\.\./.test(s) ? "*" : s.replace(/^\[(.+)\]$/, ":$1"),
    );
  return "/" + segments.join("/");
}

function importedNames(list: string): string[] {
  return list
    .split(",")
    .map(
      (n) =>
        n
          .trim()
          .replace(/^type\s+/, "")
          .split(/\s+as\s+/)[0],
    )
    .filter(Boolean);
}

/** Exported symbol → view file, read from each feature's index.ts. */
function viewSymbols(featuresDir: string): Map<string, string> {
  const map = new Map<string, string>();
  for (const feature of readdirSync(featuresDir)) {
    let source: string;
    try {
      source = readFileSync(join(featuresDir, feature, "index.ts"), "utf8");
    } catch {
      continue;
    }
    for (const m of source.matchAll(
      /export\s+\{([^}]*)\}\s+from\s+"\.\/views\/([^"]+)"/g,
    )) {
      for (const name of importedNames(m[1])) {
        map.set(`${feature}:${name}`, `${feature}/views/${m[2]}.tsx`);
      }
    }
  }
  return map;
}

export function buildRouteMap(root: string): string {
  const appDir = join(root, "src", "app", "[locale]");
  const featuresDir = join(root, "src", "features");
  const symbols = viewSymbols(featuresDir);

  const rows = walk(appDir)
    .filter((f) => f.endsWith(`${sep}page.tsx`))
    .map((file) => {
      const source = readFileSync(file, "utf8");
      const views = new Set<string>();
      for (const m of source.matchAll(
        /import\s+(?:type\s+)?\{([^}]*)\}\s+from\s+"@\/features\/([^"]+)"/g,
      )) {
        const [feature, ...rest] = m[2].split("/");
        if (rest[0] === "views" && rest[1]) {
          views.add(`${feature}/views/${rest[1]}.tsx`);
          continue;
        }
        if (rest.length) continue;
        for (const name of importedNames(m[1])) {
          const view = symbols.get(`${feature}:${name}`);
          if (view) views.add(view);
        }
      }
      return {
        url: routeUrl(relative(appDir, file)),
        page: posix(relative(join(root, "src", "app"), file)),
        views: [...views].sort(),
      };
    })
    .sort((a, b) => a.url.localeCompare(b.url));

  const lines = [
    "# Route map",
    "",
    "<!-- Generated by `npm run routes:map`. Do not edit by hand. -->",
    "",
    "Pages live in `src/app/[locale]/**/page.tsx`. The URL is the folder path without `[locale]` and without `(group)` folders; `[id]` becomes `:id`. A **view** is the screen body a page renders (`src/features/<feature>/views/`); everything else in `components/` is a reusable piece. See ADR-047.",
    "",
    "| URL | Page file (`src/app/`) | View in `src/features/` |",
    "| --- | --- | --- |",
    ...rows.map(
      (r) =>
        `| \`${r.url}\` | \`${r.page}\` | ${
          r.views.length ? r.views.map((v) => `\`${v}\``).join(", ") : "—"
        } |`,
    ),
    "",
  ];
  return lines.join("\n");
}
